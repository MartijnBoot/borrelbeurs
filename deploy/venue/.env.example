# BorrelBeurs venue settings -- copy to `.env` beside compose.yml (start.cmd does).
#
# The bundle's make_bundle.sh fills in BB_IMAGE_SHA; everything else has a default
# for the venue laptop. Never commit a filled-in `.env`: start.cmd writes a real
# JWT_SECRET into it on first run.

# The app image to run: the 40-character commit CI built and pushed. Never `latest`.
BB_IMAGE_SHA=

# The port the phones connect to. 80 means the URL needs no port.
BB_HTTP_PORT=80

# Where dumps and exports land, outside the bundle folder so a newer bundle keeps them.
BB_DATA_DIR=C:/BorrelBeurs/data

# What start.cmd prints for the phones: the laptop's reserved address on the router.
BB_PUBLIC_URL=http://192.168.8.10/

# Seconds between database dumps (SD13: every 5 minutes, the newest 288 kept).
BB_BACKUP_INTERVAL_S=300

# Signing key for sessions. Leave empty: start.cmd generates one on first run.
JWT_SECRET=
