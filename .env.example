# BorrelBeurs -- environment template.
#
# Copy this to .env.local and fill in real values; scripts/setup.sh does that
# for you and generates a real JWT_SECRET. .env.local is gitignored. This file
# is committed, so it must never contain a real secret.
#
# Every variable below is read in exactly one place: app/core/config.py.
# Nothing else under app/ or db/ may touch the environment.
#
# The application reads these from the process environment, not from a file.
# Export them before starting it:  set -a; . ./.env.local; set +a

# Required. Async SQLAlchemy URL for Postgres. Boot fails without it.
# docker-compose.yml serves this database locally; Render injects its own.
DATABASE_URL=postgresql+asyncpg://borrelbeurs:borrelbeurs@localhost:5432/borrelbeurs

# Required. Signing key for session JWTs, at least 32 characters.
# The value below is deliberately too short, so it FAILS validation and the
# app refuses to boot until you replace it. A placeholder that happened to be
# long enough would boot -- with a signing key published in this repository.
# scripts/setup.sh generates one for you; by hand:
#   openssl rand -hex 32
JWT_SECRET=generate-me

# Optional, default 8000. The TCP port the app binds. Render injects $PORT.
PORT=8000

# Optional, default INFO. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Optional, default local. One of local, ci, production.
APP_ENV=local

# Optional, default 10. Login attempts per client IP per rolling 60 seconds.
LOGIN_RATE_PER_MINUTE=10

# Optional, default true. The session cookie's Secure attribute. Set false only
# for a plain-http local stack; boot refuses false when APP_ENV=production.
SESSION_COOKIE_SECURE=true

# Optional, default 5. Seconds allowed to connect to Postgres and for any one
# statement. Bounds a database that stops answering without refusing.
DATABASE_TIMEOUT_SECONDS=5
